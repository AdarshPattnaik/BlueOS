FROM https://downloads.raspberrypi.com/${BASE_IMAGE}

PUMP 3000M

# expand_fs
INSTALL deploy/expand_fs.sh /usr/bin/expand_fs.sh
RUN chmod +x /usr/bin/expand_fs.sh

RUN touch /boot/ssh

# rfkill can't run in chroot, run here instead
RUN sed -i "\%^exit 0%irfkill unblock all" /etc/rc.local

# Copy startup.json from local checkout instead of fetching from GitHub
RUN mkdir -p /root/.config/blueos/bootstrap/
INSTALL bootstrap/startup.json.default /root/.config/blueos/bootstrap/startup.json
RUN bash -c 'sed -i "s/factory/$VERSION/g" /root/.config/blueos/bootstrap/startup.json'

# Copy install script from local checkout and run it
INSTALL install/install.sh /tmp/install.sh
RUN bash -c '
  chmod +x /tmp/install.sh
  USER=pi /tmp/install.sh --ci-run
'
